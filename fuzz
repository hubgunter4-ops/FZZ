import yaml
import requests
import urllib.parse
import time

def load_payloads(yaml_file):
    """Lee y parsea el archivo YAML."""
    try:
        with open(yaml_file, 'r', encoding='utf-8') as file:
            return yaml.safe_load(file)
    except Exception as e:
        print(f"[!] Error al leer el archivo YAML: {e}")
        return None

def fuzz_target(target_url, param_name, payloads_data):
    """Envía los payloads al parámetro especificado en la URL."""
    print(f"[*] Iniciando Fuzzing en: {target_url}")
    print(f"[*] Parámetro objetivo: {param_name}\n")

    vulnerabilidades = payloads_data.get('vulnerabilities', {})

    for vuln_type, techniques in vulnerabilidades.items():
        print(f"\n" + "="*50)
        print(f"[*] PROBANDO CATEGORÍA: {vuln_type.upper()}")
        print("="*50)
        
        for technique in techniques:
            print(f"\n[+] Técnica: {technique.get('technique', 'Desconocida')}")
            
            for payload in technique.get('payloads', []):
                # Codificar el payload para que sea seguro en la URL (URL Encoding)
                encoded_payload = urllib.parse.quote(payload)
                
                # Construir la URL final
                separator = "&" if "?" in target_url else "?"
                test_url = f"{target_url}{separator}{param_name}={encoded_payload}"
                
                try:
                    # Enviar la petición GET
                    start_time = time.time()
                    response = requests.get(test_url, timeout=10)
                    elapsed_time = time.time() - start_time
                    
                    # Mostrar resultados básicos
                    print(f"  -> Payload: {payload}")
                    print(f"     Status: {response.status_code} | Longitud: {len(response.text)} bytes | Tiempo: {elapsed_time:.2f}s")
                    
                    # Lógica simple de detección (Ejemplo para SSTI y OS Command)
                    if "49" in response.text and "7*7" in payload:
                        print("     [!!!] POSIBLE VULNERABILIDAD SSTI DETECTADA (Se evaluó 7*7=49)")
                    if "root:x:0:0:" in response.text:
                        print("     [!!!] POSIBLE LECTURA DE ARCHIVOS / OS COMMAND DETECTADA (/etc/passwd)")
                        
                except requests.exceptions.RequestException as e:
                    print(f"  -> [!] Error de conexión con payload '{payload}': {e}")
                
                # Pequeña pausa para no saturar el servidor de prueba
                time.sleep(0.5)

if __name__ == "__main__":
    # Configuración
    YAML_FILE = "payloads_testing.yml"
    
    # URL de prueba (Asegúrate de tener permiso para escanear este objetivo)
    # Ejemplo: Una aplicación local vulnerable como OWASP Juice Shop o un script propio
    TARGET_URL = "http://localhost:3000/search" 
    TARGET_PARAM = "q"

    data = load_payloads(YAML_FILE )
    if data:
        fuzz_target(TARGET_URL, TARGET_PARAM, 
        data)
